+// ---------------------------------------------------------------------------
+// The socket
+// ---------------------------------------------------------------------------
+
+static EMSCRIPTEN_WEBSOCKET_T websocket = 0;
+static EmscriptenWebSocketCreateAttributes attr;
+
+static boolean ws_started = false;    // the first connection has succeeded
+static boolean ws_open = false;       // the current socket is OPEN
+static boolean ws_connecting = false; // a handshake is in flight
+static int ws_generation = 0;         // which socket a callback belongs to
+static int ws_attempt_ms = 0;         // when the in-flight handshake began
+static int ws_retry_ms = 0;           // earliest time for the next attempt
+static int ws_failures = 0;           // consecutive attempts that never opened
+static int ws_last_rx_ms = 0;         // last frame received, of any kind
+static int ws_last_ping_ms = 0;
+static int ws_last_poll_ms = 0;      // last time WS_Poll ran at all
+static boolean ws_relay_pongs = false; // this relay answers pings
+static int ws_reconnects = 0;
+
+static void WS_ScheduleRetry(void)
+{
+    int delay = 0;
+
+    if (ws_failures > 0) {
+        delay = 250 << (ws_failures > 4 ? 4 : ws_failures - 1);
+
+        if (delay > WS_BACKOFF_MAX_MS) {
+            delay = WS_BACKOFF_MAX_MS;
+        }
+    }
+
+    ws_retry_ms = I_GetTimeMS() + delay;
+}
+
+// Raw frame: [to:u32][from:u32][payload]. Only ever called on an OPEN socket:
+// emscripten's send does not catch the exception a CONNECTING socket throws.
+static boolean WS_SendFrame(uint32_t to, const byte *data, int len)
+{
+    static char small[2048];
+    char *frame = small;
+    int r;
+
+    if (len + 8 > (int)sizeof(small)) {
+        frame = malloc(len + 8);
+
+        if (frame == NULL) {
+            return false;
+        }
+    }
+
+    memcpy(&frame[0], &to, 4);          // to
+    memcpy(&frame[4], &instanceUID, 4); // from
+
+    if (len > 0) {
+        memcpy(&frame[8], data, len);
+    }
+
+    r = emscripten_websocket_send_binary(websocket, frame, len + 8);
+
+    if (frame != small) {
+        free(frame);
+    }
+
+    return r >= 0;
+}
+
+static void WS_Ping(void)
+{
+    ws_last_ping_ms = I_GetTimeMS();
+    WS_SendFrame(WS_ADDR_RELAY, NULL, 0);
+}
+
+EM_BOOL WebSocketOpen(int eventType, const EmscriptenWebSocketOpenEvent *e, void *userData)
+{
+    if ((int)(intptr_t)userData != ws_generation) {
+        return 0;
+    }
+
+    ws_open = true;
+    ws_connecting = false;
+    ws_failures = 0;
+    ws_last_rx_ms = I_GetTimeMS();
+
+    if (ws_started) {
+        // A RECONNECT. First thing on the new socket: tell the relay our uid
+        // lives here now, so packets for us stop going to the old one. (The
+        // relay learns it from any frame; this makes it immediate instead of
+        // "whenever we next send".)
+        WS_Ping();
+
+        ++ws_reconnects;
+        printf("doom: 2, reconnected to the relay (%d)\n", ws_reconnects);
+    }
+
+    // Not on the FIRST connection, though. The host's first frame has to be
+    // its new-game announce: relay builds before relay-4 answer that announce
+    // by closing every socket they already know — and a ping sent ahead of it
+    // makes the host's own socket one of them. Against such a relay the game
+    // then could not even start. (Pings begin from WS_Poll, after the
+    // announce; the old relay ignores them.)
+
+    return 0;
+}
 
