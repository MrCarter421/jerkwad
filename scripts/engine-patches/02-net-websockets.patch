+    // CPU), the silence was ours, not the relay's: frames that arrived in the
+    // meantime are still waiting to be delivered to us. Start the clock again
+    // rather than throwing away a socket that is perfectly healthy.
+    if (now - ws_last_poll_ms > 1000) {
+        ws_last_rx_ms = now;
+    }
+
+    ws_last_poll_ms = now;
+
+    if (ws_open) {
+        if (now - ws_last_ping_ms >= WS_PING_PERIOD_MS) {
+            WS_Ping();
+        }
+
+        // Only a relay that answers pings can be judged by its silence. An
+        // older one says nothing on its own, and "nobody has sent me anything"
+        // is then also what waiting alone in a lobby looks like.
+        if (!ws_relay_pongs || now - ws_last_rx_ms < WS_SILENCE_LIMIT_MS) {
+            return;
         }
+
+        printf("doom: 6, relay silent for %d ms, reopening the socket\n", now - ws_last_rx_ms);
