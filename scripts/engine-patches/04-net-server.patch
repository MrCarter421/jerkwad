+// JERKWAD: the server's half of jw_net_leave — tell every client the game is
+// over, now, without the five-second acknowledgement wait NET_SV_Shutdown
+// does. A client that hears this stops at once with "the host ended the
+// game"; one that does not would sit frozen until its timeout.
+
+void NET_SV_LeaveNow(void)
+{
+    net_packet_t *packet;
+    int i;
+
+    if (!server_initialized) {
+        return;
+    }
+
+    for (i = 0; i < MAXNETNODES; ++i) {
+        if (ClientConnected(&clients[i])) {
+            packet = NET_NewPacket(10);
+            NET_WriteInt16(packet, NET_PACKET_TYPE_DISCONNECT);
+            NET_Conn_SendPacket(&clients[i].connection, packet);
+            NET_FreePacket(packet);
+        }
+    }
+}
