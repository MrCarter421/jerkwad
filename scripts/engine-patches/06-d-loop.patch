+// JERKWAD: the relay routes by this number, so two players must never share
+// one. It used to be `srand(time(NULL)); rand() % 0xfffe` — seeded by the
+// clock in whole seconds, so two friends who pressed JOIN in the same second
+// got the SAME uid and the relay could not tell them apart; and it could come
+// out as 1 (the host's own uid) or 0 (which the relay treats as "new game").
+// 31 random bits from the browser, never 0 or 1.
+static uint32_t JW_RandomUID(void)
+{
+    uint32_t hi = (uint32_t)(emscripten_random() * 32768.0f) & 0x7fff;
+    uint32_t lo = (uint32_t)(emscripten_random() * 65536.0f) & 0xffff;
+    uint32_t uid = (hi << 16) | lo;
+
+    return uid < 2 ? uid + 2 : uid;
+}
