+// JERKWAD: say when the game is being held up waiting for another player.
+// Lockstep netcode cannot advance without everyone's input, so while one
+// player's tab is hidden or their network is stalled the others' games simply
+// stop. With the 4 s timeout that state never lasted long enough to notice;
+// now that a stalled player is waited for, a frozen screen with no
+// explanation would read as a hang. The page shows "waiting for players".
+// Momentary waits (ordinary latency) end long before the 1.5 s threshold.
+static void JW_ReportStall(boolean stalled)
+{
+    static int since_ms = 0;
+    static boolean reported = false;
+
+    if (stalled && net_client_connected) {
+        int now = I_GetTimeMS();
+
+        if (since_ms == 0) {
+            since_ms = now != 0 ? now : 1;
+        }
+        else if (!reported && now - since_ms > 1500) {
+            printf("doom: 15, waiting for another player\n");
+            reported = true;
+        }
+    }
+    else {
+        if (reported) {
+            printf("doom: 16, game resumed\n");
+        }
+
+        since_ms = 0;
+        reported = false;
+    }
+}
